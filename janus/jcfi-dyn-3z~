#gdb --args $TOOLDIR/bin64/drrun -c $JANUSLIB/libjguard.so @$hintfile @1 @0 -- $binfile $@
#$TOOLDIR/bin64/drrun -debug -checklevel 0 -loglevel 4 -c $JANUSLIB/libjcfi.so @$hintfile @1 @0 -- $binfile $@
$TOOLDIR/bin32/drrun  -ops "-opt_cleancall 3" -c $JANUSLIB/libjcfi.so @$hintfile @1 @0 -- $binfile $@
